  "description": "Google Search Console MCP server and CLI for Claude Code, Codex and AI agents. 19 tools for search analytics, URL inspection, sitemaps and property verification.",
  "type": "module",
  "bin": {
    "google-search-console-mcp": "dist/index.js",
    "google-search-console-cli": "dist/index.js",
    "google-search-console-mcp-cli": "dist/npx.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
