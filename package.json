  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/google-search-console-mcp-cli.git"
  },
  "homepage": "https://github.com/thenavidm/google-search-console-mcp-cli",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.8"
  }
